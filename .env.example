# Prebuilt public images. Use the same version/SHA for all four images.
GHCR_NAMESPACE=skotow
IMAGE_TAG=latest
POSTGRES_USER=sipshield
POSTGRES_DB=sipshield
# ./install.sh generates missing credentials; manual installs must set these.
POSTGRES_PASSWORD=
# Optional override for all services; blank derives connection from POSTGRES_*.
# If set, use the same bundled DB and percent-encode reserved password characters.
DATABASE_URL=
REDIS_URL=redis://redis:6379
API_PORT=8080
DASHBOARD_PORT=3000
MANAGEMENT_BIND_ADDRESS=127.0.0.1
# Local testing default. Set 0.0.0.0 only with SIP firewall rules in place.
SIP_BIND_ADDRESS=127.0.0.1
SIP_LISTEN_PORT=5060
# Docker bridge: host.docker.internal reaches a PBX running on your computer.
SIP_BACKEND_HOST=host.docker.internal
SIP_BACKEND_PORT=5070
SIP_ADVERTISED_HOST=127.0.0.1
ADMIN_USER=admin
ADMIN_PASSWORD=
SESSION_SECRET=
COOKIE_SECURE=false
# Optional; saved dashboard settings take precedence.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
